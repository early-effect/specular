#!/usr/bin/env bash
# Reject commits that would fail CI's scalafmtCheckAll.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [ "${CURSOR_SANDBOX:-}" = "seatbelt" ]; then
  echo "pre-commit: skipping scalafmt under Cursor agent sandbox."
  exit 0
fi

if ! command -v scalafmt >/dev/null 2>&1; then
  echo "pre-commit: scalafmt not found on PATH" >&2
  exit 1
fi

echo "pre-commit: running scalafmt --check…"
if ! scalafmt --check; then
  echo >&2
  echo "pre-commit: BLOCKED; scalafmt --check failed." >&2
  echo "  Fix with:  scalafmt && git add -u" >&2
  echo "  Then commit again." >&2
  exit 1
fi

echo "pre-commit: OK; scalafmt --check passed."
