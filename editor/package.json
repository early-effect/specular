{
  "name": "specular-editor",
  "displayName": "Specular",
  "publisher": "early-effect",
  "version": "0.0.1",
  "description": "Tests-as-docs for Scala: markdown inside a DocSpec, and a live Specular preview.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/early-effect/specular.git"
  },
  "homepage": "https://github.com/early-effect/specular",
  "categories": [
    "Other"
  ],
  "keywords": [
    "scala",
    "documentation",
    "markdown",
    "preview"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:scala"
  ],
  "contributes": {
    "commands": [
      {
        "command": "specular.newDocSpec",
        "title": "Specular: New DocSpec"
      },
      {
        "command": "specular.editMarkdown",
        "title": "Specular: Edit as Markdown"
      },
      {
        "command": "specular.editMermaid",
        "title": "Specular: Edit as Mermaid"
      },
      {
        "command": "specular.insertSnippet",
        "title": "Specular: Insert snippet"
      },
      {
        "command": "specular.openPreview",
        "title": "Open Preview",
        "category": "Specular",
        "icon": "$(open-preview)"
      },
      {
        "command": "specular.showStructure",
        "title": "Specular: Show structure"
      },
      {
        "command": "specular.previewDiagram",
        "title": "Specular: Preview diagram"
      }
    ],
    "configuration": {
      "title": "Specular",
      "properties": {
        "specular.previewCommand": {
          "type": "string",
          "default": "sbt docs/specularPreview",
          "description": "Shell command the Open preview lens runs. In this repo that is the docs preview task."
        },
        "specular.previewOrigin": {
          "type": "string",
          "default": "http://localhost:8765",
          "description": "Origin of the specularPreview server. The split preview opens <origin>/<slug>.html."
        }
      }
    },
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ]
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      },
      {
        "scopeName": "specular.markdown-string",
        "path": "./syntaxes/markdown-in-scala.json",
        "injectTo": [
          "source.scala"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.markdown": "markdown"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "specular.openPreview",
          "when": "editorLangId == scala && specular.hasPage",
          "group": "navigation"
        }
      ]
    }
  }
}
