{
  "name": "specular-editor",
  "displayName": "Specular",
  "publisher": "early-effect",
  "version": "0.0.1",
  "description": "Edit Specular pages: markdown and mermaid fragments, outline, and the preview task.",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:scala"
  ],
  "contributes": {
    "commands": [
      {
        "command": "specular.newDocSpec",
        "title": "Specular: New DocSpec"
      },
      {
        "command": "specular.editMarkdown",
        "title": "Specular: Edit as Markdown"
      },
      {
        "command": "specular.editMermaid",
        "title": "Specular: Edit as Mermaid"
      },
      {
        "command": "specular.insertSnippet",
        "title": "Specular: Insert snippet"
      },
      {
        "command": "specular.openPreview",
        "title": "Specular: Open preview"
      }
    ],
    "configuration": {
      "title": "Specular",
      "properties": {
        "specular.previewCommand": {
          "type": "string",
          "default": "sbt docs/specularPreview",
          "description": "Shell command the Open preview lens runs. In this repo that is the docs preview task."
        }
      }
    },
    "languages": [
      {
        "id": "mermaid",
        "aliases": ["Mermaid"]
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ]
  }
}
